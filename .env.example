# IBM_BOB_API_KEY: Official API key for IBM Bob Inference API
# Obtain from bob.ibm.com (scoped to Inference or General with Team ID)
# Used server-side only in Node.js backend. NEVER commit real keys.
IBM_BOB_API_KEY="your_key_here"

# Optional: IBM Bob inference base URL (defaults to https://api.us-east.bob.ibm.com/inference/v1)
# IBM_BOB_BASE_URL="https://api.us-east.bob.ibm.com/inference/v1"

# Optional: IBM Bob model identifier (defaults to pro, or fast / premium)
# IBM_BOB_MODEL="pro"

# Optional: IBM Bob auth scheme override ("Apikey" by default for Inference API keys, "Bearer" for JWT/SSO tokens)
# IBM_BOB_AUTH_SCHEME="Apikey"

# Optional: IBM Bob routing headers (for General API keys)
# IBM_BOB_TEAM_ID=""
# IBM_BOB_INSTANCE_ID=""

# GEMINI_API_KEY: Platform injected
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

